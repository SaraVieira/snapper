[sub_resource type="Shader" id="Shader_7fucf"]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D OutsideLine : filter_nearest;
uniform float FloatParameter;
uniform sampler2D InsideTexture : filter_nearest;
uniform vec4 Color: source_color;



void fragment() {
	float outsideTextureAlpha = texture(OutsideLine, UV).a;
	float insideTextureAlpha = texture(InsideTexture, UV).a;
	bool isWtv = UV.x < FloatParameter;
	if(isWtv) {
		COLOR.a = insideTextureAlpha;		
	} else {
		 COLOR.a = 0.0;	
	}	
	COLOR.rgb = Color.rgb;
	COLOR.a += outsideTextureAlpha;
	
}
"

